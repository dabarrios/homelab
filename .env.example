# Shared Docker environment example
# Copy this file to .env and replace every example value for your system.

# Shared identity and storage
PUID=1000
PGID=1000
TZ=Etc/UTC
DOWNLOADS_PATH=/srv/media/downloads
MOVIES_PATH=/srv/media/movies
SHOWS_PATH=/srv/media/tv
ANIME_MOVIES_PATH=/srv/media/anime/movies
ANIME_SERIES_PATH=/srv/media/anime/series

# automation-stack
BAZARR_HOST_PORT=6001
BAZARR_ANIME_HOST_PORT=6002
RADARR_HOST_PORT=6003
RADARR_ANIME_HOST_PORT=6004
SONARR_HOST_PORT=6005
SONARR_ANIME_HOST_PORT=6006
PROWLARR_HOST_PORT=6007

# cloud-stack
CLOUD_SYNC_PATH=/srv/cloud/files
FILEBROWSER_HOST_PORT=9001
SYNCTHING_HOST_PORT=9002
SYNCTHING_TCP_HOST_PORT=9003
SYNCTHING_UDP_HOST_PORT=9003
SYNCTHING_DISCOVERY_HOST_PORT=9004

# database-stack
SQL_USER=example_user
SQL_PW=change-me
SQL_ROOT_PW=change-me
SQL_DB=example_database

# dns-stack
SUBNET=192.168.1.0/24
GATEWAY=192.168.1.1
IPV4_ADDRESS=192.168.1.53
PARENT_NETWORK_CARD=eth0
WEB_SERVER_PASSWORD=change-me

# frontend-stack
JELLYFIN_SERVER_URL=http://192.168.1.10:8001
RENDER_GROUP=1000
JELLYFIN_HOST_PORT=8001
JELLYSEERR_HOST_PORT=8002

# game-stack
MC1_DATA_PATH=/srv/minecraft/mc1
MC2_DATA_PATH=/srv/minecraft/mc2
MC3_DATA_PATH=/srv/minecraft/mc3
MC1_BACKUP_PATH=/srv/backups/minecraft/mc1
MC2_BACKUP_PATH=/srv/backups/minecraft/mc2
MC3_BACKUP_PATH=/srv/backups/minecraft/mc3
BACKUP_SERVER_PORT=25565
MC1_MEMORY_ALLOCATION=6G
MC1_VERSION=1.21.11
MC1_MOTD=Welcome to Minecraft Server One
MC1_RCON_PORT=25575
MC1_IMAGE_TAG=latest
MC2_MEMORY_ALLOCATION=4G
MC2_VERSION=1.21.11
MC2_MOTD=Welcome to Minecraft Server Two
MC2_RCON_PORT=25576
MC2_IMAGE_TAG=latest
MC3_MEMORY_ALLOCATION=8G
MC3_VERSION=1.21.1
MC3_MOTD=Welcome to Minecraft Server Three
MC3_RCON_PORT=25577
MC3_IMAGE_TAG=java21
DEFAULT_OPS=example_admin
GROUP_WHITELIST=example_admin,example_player
GROUP_MAX_PLAYERS=13
PRIVATE_WHITELIST=example_admin
PRIVATE_MAX_PLAYERS=1

# immich-stack
IMMICH_UPLOAD_PATH=/srv/photos/library
IMMICH_DB_PATH=/srv/photos/database
IMMICH_HOST_PORT=9101
IMMICH_VERSION=release
DB_PASSWORD=change-me
DB_USERNAME=example_user
DB_NAME=example_photos

# management-stack
HOMARR_ENCRYPTION_KEY=generate-a-long-random-key
HOMARR_HOST_PORT=4001
PORTAINER_HOST_PORT=4002

# monitoring-stack
MINIO_ROOT_USER=example_admin
MINIO_ROOT_PASSWORD=change-me
ALLOY_HOST_PORT=4101
DASHDOT_HOST_PORT=4102
GRAFANA_HOST_PORT=4103
LOKI_GATEWAY_HOST_PORT=4104
UPTIME_KUMA_HOST_PORT=4105

# paperless-stack
PAPERLESS_AI_HOST_PORT=3101
PAPERLESS_WEB_HOST_PORT=3102
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=deu spa chi_sim chi_tra jpn rus tur ces ara
POSTGRES_DB=example_documents
POSTGRES_USER=example_user
POSTGRES_PASSWORD=change-me

# utilities-stack
BENTOPDF_HOST_PORT=3001
OMNI_TOOLS_HOST_PORT=3002

# vpn-stack
INCOMPLETE_DOWNLOADS_PATH=/srv/media/downloads/incomplete
TORRENTS_PATH=/srv/media/torrents
SERVER_COUNTRIES=United States,Canada,Switzerland,Netherlands
WIREGUARD_PRIVATE_KEY=replace-with-wireguard-private-key
QBITTORRENT_HOST_PORT=6101
