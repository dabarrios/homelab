# Generate a unique value; never reuse this placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dashboard.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DJANGO_HSTS_SECONDS=0

# Container runtime
HOMELAB_PORT=7716
# Find with: stat -c %g /var/run/docker.sock
DOCKER_GID=987

# Palworld live-save sync for Docker deployments. This is a host path;
# Compose mounts it read-only at /palworld-save inside the dashboard.
PALWORLD_LIVE_SAVE_HOST_DIR=/path/to/Pal/Saved/SaveGames/0/WORLD_ID
